/** Чистая раскладка без DOM — пригодна для Web Worker. */

export interface LayoutPoint {
  x: number;
  y: number;
}

export interface LayoutNodeInput {
  id: string;
  groupKey: string;
}

export interface LayoutEdgeInput {
  source: string;
  target: string;
}

export interface LayoutJobInput {
  nodes: LayoutNodeInput[];
  edges: LayoutEdgeInput[];
  fresh?: boolean;
  saved?: Array<[string, LayoutPoint]>;
}

export interface LayoutJobResult {
  positions: Array<[string, LayoutPoint]>;
}

const REPULSE_R = 140;
const GRID_CELL = REPULSE_R;

function jitter(i: number, j: number): { dx: number; dy: number } {
  const h = (i * 73856093) ^ (j * 19349663);
  return {
    dx: ((h & 255) / 255 - 0.5) * 8,
    dy: (((h >> 8) & 255) / 255 - 0.5) * 8,
  };
}

function repulseIters(n: number, fresh: boolean): number {
  const base = fresh
    ? Math.min(80, 18 + Math.floor(4000 / Math.max(8, n)))
    : Math.min(24, 8 + Math.floor(1200 / Math.max(8, n)));
  if (n > 600) return Math.min(base, Math.max(10, Math.floor(3500 / n)));
  return base;
}

function buildGrid(ids: string[], pos: Map<string, LayoutPoint>): Map<string, number[]> {
  const grid = new Map<string, number[]>();
  for (let i = 0; i < ids.length; i++) {
    const p = pos.get(ids[i])!;
    const key = `${Math.floor(p.x / GRID_CELL)},${Math.floor(p.y / GRID_CELL)}`;
    if (!grid.has(key)) grid.set(key, []);
    grid.get(key)!.push(i);
  }
  return grid;
}

/** Spatial-grid repulse: ~O(N·k) вместо O(N²). */
export function computeLayout(input: LayoutJobInput): LayoutJobResult {
  const { nodes, edges, fresh = false } = input;
  const saved = new Map(input.saved || []);
  const pos = new Map<string, LayoutPoint>();
  if (!nodes.length) return { positions: [] };

  if (!fresh && nodes.every((n) => saved.has(n.id))) {
    return { positions: nodes.map((n) => [n.id, saved.get(n.id)!]) };
  }

  const groups = new Map<string, LayoutNodeInput[]>();
  for (const n of nodes) {
    if (!groups.has(n.groupKey)) groups.set(n.groupKey, []);
    groups.get(n.groupKey)!.push(n);
  }

  const keys = [...groups.keys()].sort();
  const ring = fresh
    ? Math.max(140, 48 * Math.sqrt(keys.length) + 22 * Math.sqrt(nodes.length))
    : Math.max(420, 140 * Math.sqrt(keys.length));

  keys.forEach((key, gi) => {
    const members = groups.get(key)!;
    const angle = (gi / keys.length) * Math.PI * 2 - Math.PI / 2;
    const cx = Math.cos(angle) * ring;
    const cy = Math.sin(angle) * ring;
    const localR = 48 + 22 * Math.sqrt(members.length);
    members.forEach((n, i) => {
      const prev = fresh ? undefined : saved.get(n.id);
      if (prev) {
        pos.set(n.id, { x: prev.x, y: prev.y });
        return;
      }
      const a = (i / Math.max(1, members.length)) * Math.PI * 2;
      const r = members.length === 1 ? 0 : localR * (0.35 + 0.65 * ((i % 5) / 5));
      pos.set(n.id, { x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r });
    });
  });

  const ids = nodes.map((n) => n.id);
  const index = new Map(ids.map((id, i) => [id, i]));
  const adj: number[][] = ids.map(() => []);
  for (const e of edges) {
    const a = index.get(e.source);
    const b = index.get(e.target);
    if (a == null || b == null || a === b) continue;
    adj[a].push(b);
    adj[b].push(a);
  }

  const iters = repulseIters(ids.length, fresh);
  for (let k = 0; k < iters; k++) {
    const grid = buildGrid(ids, pos);
    for (let i = 0; i < ids.length; i++) {
      const a = pos.get(ids[i])!;
      let fx = 0;
      let fy = 0;
      const cx = Math.floor(a.x / GRID_CELL);
      const cy = Math.floor(a.y / GRID_CELL);
      for (let gx = -1; gx <= 1; gx++) {
        for (let gy = -1; gy <= 1; gy++) {
          const bucket = grid.get(`${cx + gx},${cy + gy}`);
          if (!bucket) continue;
          for (const j of bucket) {
            if (j <= i) continue;
            const b = pos.get(ids[j])!;
            let dx = a.x - b.x;
            let dy = a.y - b.y;
            let d2 = dx * dx + dy * dy;
            if (d2 < 4) {
              const jt = jitter(i, j);
              dx = jt.dx;
              dy = jt.dy;
              d2 = dx * dx + dy * dy;
            }
            const d = Math.sqrt(d2);
            if (d < REPULSE_R) {
              const force = (REPULSE_R - d) / d * 0.35;
              fx += dx * force;
              fy += dy * force;
              b.x -= dx * force * 0.5;
              b.y -= dy * force * 0.5;
            }
          }
        }
      }
      for (const j of adj[i]) {
        if (j <= i) continue;
        const b = pos.get(ids[j])!;
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 1;
        const pull = (d - 150) * 0.012;
        a.x += dx / d * pull;
        a.y += dy / d * pull;
        b.x -= dx / d * pull;
        b.y -= dy / d * pull;
      }
      a.x += fx * 0.08;
      a.y += fy * 0.08;
    }
  }

  return { positions: ids.map((id) => [id, pos.get(id)!]) };
}
